# Pullim Admissions Coach — 환경 변수 예시
# 이 파일을 .env.local 로 복사하고 실제 값을 채워 주세요.
# .env.local 은 git에 올리지 않습니다 (.gitignore 확인).

# Anthropic API 키 (server-only, NEXT_PUBLIC 아님)
# 없으면 /api/analyze 가 데모 결과(parkJunho mock)를 반환합니다.
ANTHROPIC_API_KEY=sk-ant-...

# ── 실 인증(B) · 로컬 SSO ──────────────────────────────────────────────────
# 아래 NEXT_PUBLIC_PULLIM_API 가 설정되면 인증 어댑터가 mock → 실(pullim-api 쿠키 SSO)로
# 전환된다(lib/auth/index.ts). 미설정이면 mock(데모) 유지.
#
# 로컬 서브도메인 SSO 셋업 절차(= /etc/hosts 한 줄 + 검증)는 pullim-web 런북이 SoT:
#   https://github.com/curea-co/pullim-web/blob/dev/docs/common/2026-06-22-local-pullim-local-sso/runbook.md
# 입시코치 로컬: 포트 3007 / 호스트 admission.pullim.local:3007 (SoT: pullim-api .claude/rules/local-ports.md)
#   /etc/hosts → 127.0.0.1 pullim.local os.pullim.local api.pullim.local admission.pullim.local

# pullim-api 베이스 URL — 로컬 SSO: api.pullim.local 로 호출해야 same-site 쿠키가 실린다.
NEXT_PUBLIC_PULLIM_API=http://api.pullim.local:3000

# 중앙 로그인(OS) 베이스 URL — "로그인" 클릭 시 ${OS}/login?next=<현재 URL> 로 보낸다(ADR-010).
# prod: https://os.pullim.ai (canonical). 마케팅 apex pullim.ai 도 로그인 UI 노출 가능.
NEXT_PUBLIC_OS_URL=http://os.pullim.local:3001

# access 쿠키 이름(로컬). config-catalog SoT: local-pullim-at
NEXT_PUBLIC_ACCESS_COOKIE_NAME=local-pullim-at
